FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      DEDProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Wire directed-energy-deposition feed (Strategy A: Eulerian volumetric
// source). Mass rate mdot = rho1 * (pi*wireDiameter^2/4) * wireFeedSpeed.

wireDiameter        1e-4;       // [m] feedstock wire diameter
wireFeedSpeed       0.2;        // [m/s] wire feed speed (sets mass rate)

// Velocity given to the injected feedstock (direction + speed). Here +y is
// into the substrate (y increases downward in this case) - wire pushed
// gently down into the melt pool.
feedVelocity        (0 0.05 0); // [m/s]

// HOT wire: injected metal arrives molten (above liquidus 1933 K) so it
// merges into the melt pool and surface tension consolidates it into a bead,
// instead of sitting as a cold diffuse cloud in the gas.
feedTemperature     2000;       // [K] molten feedstock
feedCp              700;        // [J/(kg K)] feedstock specific heat

// Feed region: sphere of this radius centred on the laser scan point plus
// feedCentreOffset. Offset places the sphere ON the surface (laser sits
// 50 um above the surface at y=0.05mm; surface is at y=0.10mm) so the wire
// feeds directly into the pool, straddling the gas/metal interface.
feedRadius          5e-5;       // [m]
feedCentreOffset    (0 5e-5 0); // [m] relative to laser position

feedStartTime       0;          // [s]
// feedEndTime      GREAT;      // [s] (default: always on)

