#!/bin/bash

set -e
set -o pipefail

caseDir="$(cd "$(dirname "$0")" && pwd)"
cd "$caseDir"

# Parallel Tao Sun / Zhang 2025 Al6061 validation run.
# Uses system/decomposeParDict; currently configured for 8 subdomains.

convertVTK=true
analyzeMeltpool=true
pythonExe=$(which python3 || which python || echo "python3")

latestConvertedVTK()
{
    find VTK -maxdepth 1 -type f \( -name "*.vtk" -o -name "internal.vtu" \) -printf '%T@ %p\n' 2>/dev/null \
        | sort -g \
        | tail -1 \
        | cut -d' ' -f2-
}

postProcessWrittenTime()
{
    local timeName="$1"
    local vtkFile=""

    if ! ./foamVTK.sh "$timeName"; then
        echo "ERROR: foamVTK.sh failed for time ${timeName}" >&2
        touch .postProcessFailed
        return 1
    fi

    if ${analyzeMeltpool}; then
        vtkFile="$(latestConvertedVTK)"

        if [ -z "$vtkFile" ]; then
            echo "ERROR: no VTK/VTU file found after converting ${timeName}" >&2
            touch .postProcessFailed
            return 1
        fi

        MPLCONFIGDIR="${MPLCONFIGDIR:-/tmp}" "$pythonExe" \
            scripts/analyze_meltpool_vtu.py \
            --vtk-file "$vtkFile" \
            || { echo "ERROR: meltpool analysis failed for ${vtkFile}" >&2; touch .postProcessFailed; return 1; }

        MPLCONFIGDIR="${MPLCONFIGDIR:-/tmp}" "$pythonExe" \
            scripts/plot_recoil_history.py \
            || echo "WARNING: recoil history plotting failed" >&2
    fi
}

postProcessQueueWorker()
{
    local queueFile="$1"
    local queuedTime=""

    while IFS= read -r queuedTime
    do
        if [ "$queuedTime" = "__DONE__" ]; then
            break
        fi

        if [ -f .postProcessFailed ]; then
            break
        fi

        postProcessWrittenTime "$queuedTime" || break
    done < "$queueFile"
}

convertOnWrite()
{
    local currentTime=""
    local lastProcessedTime=""
    local queueFile=""
    local workerPid=""

    rm -f .postProcessFailed
    queueFile="$(mktemp -u ".postProcessQueue.XXXXXX")"
    mkfifo "$queueFile"
    postProcessQueueWorker "$queueFile" &
    workerPid="$!"
    exec 3>"$queueFile"
    rm -f "$queueFile"

    while IFS= read -r line
    do
        echo "$line"

        if [ -f .postProcessFailed ]; then
            echo "ERROR: Post-processing step failed. Terminating simulation..." >&2
            kill "$workerPid" 2>/dev/null || true
            exit 1
        fi

        case "$line" in
            "Time = "*)
                currentTime="${line#Time = }"
                ;;
            "Writing "*|"Writing data at time "*)
                if [ -n "$currentTime" ] && [ "$currentTime" != "$lastProcessedTime" ]; then
                    echo "Queueing VTK conversion for time ${currentTime}"
                    printf '%s\n' "$currentTime" >&3
                    lastProcessedTime="$currentTime"
                fi
                ;;
        esac
    done

    printf '%s\n' "__DONE__" >&3
    exec 3>&-
    wait "$workerPid"

    if [ -f .postProcessFailed ]; then
        echo "ERROR: Post-processing step failed at end of run." >&2
        exit 1
    fi
}

. "$WM_PROJECT_DIR/bin/tools/RunFunctions"

nCores=$(foamDictionary -entry numberOfSubdomains -value system/decomposeParDict)

# Check if processor0 exists and contains any time step directories
resumeRun=false
if [ -d processor0 ]; then
    numTimes=$(find processor0 -maxdepth 1 -type d -printf '%f\n' | grep -E '^[0-9]' | wc -l)
    if [ "$numTimes" -gt 0 ]; then
        resumeRun=true
    fi
fi

if ${resumeRun}; then
    echo "=========================================================="
    echo "Existing simulation data found in processor directories."
    echo "Resuming parallel run from the latest time step..."
    echo "=========================================================="
else
    echo "=========================================================="
    echo "No existing run found. Setting up simulation from scratch..."
    echo "=========================================================="
    rm -rf 0 processor* VTK VTKs postProcessing log.*
    cp -r initial 0

    find 0 -name "*.orig" -exec bash -c 'cp "$0" "${0%.orig}"' {} \;

    runApplication blockMesh
    runApplication setFields
    runApplication decomposePar
fi

if ${convertVTK}; then
    mpirun --oversubscribe -np "$nCores" \
        stdbuf -oL \
        laserbeamFoam \
        -parallel \
        2>&1 | convertOnWrite | tee -a log.laserbeamFoam
else
    mpirun --oversubscribe -np "$nCores" \
        stdbuf -oL \
        laserbeamFoam \
        -parallel \
        2>&1 | tee -a log.laserbeamFoam
fi

touch taosunAL6061.foam
