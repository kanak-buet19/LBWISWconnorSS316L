FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      PhaseFieldProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

timeVsLaserPosition
{
    file    "$FOAM_CASE/constant/timeVsLaserPosition";
    outOfBounds clamp;
}

timeVsLaserPower
{
    file    "$FOAM_CASE/constant/timeVsLaserPower";
    outOfBounds clamp;
}

// Previous-solver AMB process settings.
pulseLaser false;

V_incident	(0.087 0.996 0);  // 5 deg inclined laser

laserRadius 36e-6;

N_sub_divisions	1;

nRadial	35; //50

nAngular	240; //360

wavelength	1.064e-6;

e_num_density	1.8e29;
//elec_resistivity	1.0e-6;

Radius_Flavour	3.0;

PowderSim false;

useLocalSearch    true;//false;

