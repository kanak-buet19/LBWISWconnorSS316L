FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1.0;

// CW single-track 316L bareplate calibration (Hofmann 2026).
// P=200W, v=900mm/s, d_laser=0.05mm. Target: depth~94um, width~115um.
// x=cross-track, y=depth (y=0=top/atmosphere), z=scan direction.
// MESH CONVERGENCE: Base 32 um; 3-level AMR → 4 um near melt pool.
//   x: 0.512 mm  (16 cells — ~4.5x pool half-width)
//   y: 0.320 mm  (10 cells — 0.128 mm gas + 0.192 mm substrate)
//   z: 0.960 mm  (30 cells — 0.23 mm lead + 0.50 mm track + 0.23 mm lag)

vertices
(
    (0         0         0        )  // 0
    (0.512e-3  0         0        )  // 1
    (0.512e-3  0.320e-3  0        )  // 2
    (0         0.320e-3  0        )  // 3
    (0         0         0.960e-3 )  // 4
    (0.512e-3  0         0.960e-3 )  // 5
    (0.512e-3  0.320e-3  0.960e-3 )  // 6
    (0         0.320e-3  0.960e-3 )  // 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (16 10 30) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    lowerWall
    {
        type wall;
        faces
        (
            (3 7 6 2)
        );
    }

    atmosphere
    {
        type patch;
        faces
        (
            (1 5 4 0)
        );
    }

    rightWall
    {
        type patch;
        faces
        (
            (1 2 6 5)
        );
    }

    leftWall
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }

    frontAndBack
    {
        type patch;
        faces
        (
            (0 3 2 1)
            (5 6 7 4)
        );
    }
);

mergePatchPairs
(
);

