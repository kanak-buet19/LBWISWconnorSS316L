FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      PhaseFieldProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

timeVsLaserPosition
{
    file    "$FOAM_CASE/constant/timeVsLaserPosition";
    outOfBounds clamp;
}

timeVsLaserPower
{
    file    "$FOAM_CASE/constant/timeVsLaserPower";
    outOfBounds clamp;
}

// CW single-track 316L bareplate calibration (Hofmann 2026 dataset).
// P=200W, v=900mm/s, d_laser=0.05mm (radius=25um).
// Scan 1.0mm in z; track time = 1.111 ms.  Used to calibrate elec_resistivity.
pulseLaser false;

V_incident	(0 1 0);

laserRadius 26e-6;  // 50 um spot diameter (Hofmann d_laser=0.05 mm)

N_sub_divisions	1;

nRadial	35; //50

nAngular	240; //360

wavelength	1.070e-6;

e_num_density	4e29;
//elec_resistivity	1.0e-6;

Radius_Flavour	2.0;

PowderSim false;

useLocalSearch    true;//false;

//N_sub_divisions    6;
