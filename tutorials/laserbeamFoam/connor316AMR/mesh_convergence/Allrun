#!/bin/bash
# Run all mesh convergence cases sequentially, then plot comparison.
# Usage:
#   ./Allrun              — run all cases (4um, 6um, 8um) then plot
#   ./Allrun mesh_8um     — run only the specified case
#   ./Allrun --plot-only  — skip simulations, only run comparison plot

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

CASES=(mesh_8um mesh_6um mesh_4um)
pythonExe="${PYTHON:-/home/kanak/.venv/venv314/bin/python}"

run_case()
{
    local caseName="$1"
    if [ ! -d "$caseName" ]; then
        echo "[ERROR] Case directory not found: $caseName"
        exit 1
    fi

    echo ""
    echo "============================================================"
    echo "  Running $caseName"
    echo "============================================================"
    (cd "$caseName" && bash Allrun_long)
    echo "[DONE] $caseName completed."
}

run_plot()
{
    echo ""
    echo "============================================================"
    echo "  Running mesh convergence comparison plot"
    echo "============================================================"
    MPLCONFIGDIR="${MPLCONFIGDIR:-/tmp}" "$pythonExe" \
        scripts/plot_mesh_convergence.py \
        || { echo "[ERROR] Comparison plot failed."; exit 1; }
    echo "[DONE] Comparison plot written to results/mesh_convergence_comparison.pdf"
}

if [ "$1" = "--plot-only" ]; then
    run_plot
    exit 0
fi

if [ $# -gt 0 ]; then
    for arg in "$@"; do
        run_case "$arg"
    done
else
    for caseName in "${CASES[@]}"; do
        run_case "$caseName"
    done
fi

run_plot
