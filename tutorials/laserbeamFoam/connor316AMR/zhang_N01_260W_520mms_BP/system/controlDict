FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Zhang N01: 260 W / 0.52 m/s — KEYHOLE mode (W/D = 0.633)
// Track: 800 um at 0.52 m/s = 1.5385 ms + 161 us cooldown = 1.7 ms total

application     laserbeamFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         1.7e-3;

deltaT          1e-7;

writeControl    runTime;

writeInterval   5e-5;           // 50 us per write -> ~34 snapshots

purgeWrite      0;

writeFormat     ascii;

writePrecision  10;

writeCompression uncompressed;

timeFormat      general;

timePrecision   10;

runTimeModifiable no;

adjustTimeStep  yes;

maxCo           0.35;
maxAlphaCo      0.35;

maxDeltaT       1e-6;

debugNumerics              false;
debugNumericsInterval      25;
debugNumericsSmallDeltaT   5e-8;
debugNumericsSmallDeltaTInterval 5;
debugNumericsCoFraction    0.95;

// ************************************************************************* //
