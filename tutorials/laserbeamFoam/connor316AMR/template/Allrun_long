#!/bin/bash

set -o pipefail

## Notes:
# has dynamic meshing; 8 core job
# In future could also test with `blastAMR`

# User options:
bParallel=true # Only set to false for debugging purposes.
convertVTK=true # Convert written times to VTK during the solver run.
analyzeMeltpool=true # Analyze each newly converted VTU during the solver run.
pythonExe="${PYTHON:-/home/kanak/.venv314/bin/python}"

latestInternalVTU()
{
    find VTK -path "*/internal.vtu" -type f -printf '%T@ %p\n' 2>/dev/null \
        | sort -g \
        | tail -1 \
        | cut -d' ' -f2-
}

postProcessWrittenTime()
{
    local timeName="$1"
    local vtkFile=""

    if ! ./foamVTK.sh "$timeName"; then
        echo "WARNING: foamVTK.sh failed for time ${timeName}" >&2
        return 0
    fi

    if ${analyzeMeltpool}; then
        vtkFile="$(latestInternalVTU)"

        if [ -z "$vtkFile" ]; then
            echo "WARNING: no internal.vtu found after converting ${timeName}" >&2
            return 0
        fi

        MPLCONFIGDIR="${MPLCONFIGDIR:-/tmp}" "$pythonExe" \
            scripts/analyze_meltpool_vtu.py \
            --vtk-file "$vtkFile" \
            || echo "WARNING: meltpool analysis failed for ${vtkFile}" >&2
    fi
}

postProcessQueueWorker()
{
    local queueFile="$1"
    local queuedTime=""

    while IFS= read -r queuedTime
    do
        if [ "$queuedTime" = "__DONE__" ]; then
            break
        fi

        postProcessWrittenTime "$queuedTime"
    done < "$queueFile"
}

convertOnWrite()
{
    local currentTime=""
    local lastProcessedTime=""
    local queueFile=""
    local workerPid=""

    queueFile="$(mktemp -u ".postProcessQueue.XXXXXX")"
    mkfifo "$queueFile"
    postProcessQueueWorker "$queueFile" &
    workerPid="$!"
    exec 3>"$queueFile"
    rm -f "$queueFile"

    while IFS= read -r line
    do
        echo "$line"

        case "$line" in
            "Time = "*)
                currentTime="${line#Time = }"
                ;;
            "Writing "*|"Writing data at time "*)
                if [ -n "$currentTime" ] && [ "$currentTime" != "$lastProcessedTime" ]; then
                    echo "Queueing VTK conversion for time ${currentTime}"
                    printf '%s\n' "$currentTime" >&3
                    lastProcessedTime="$currentTime"
                fi
                ;;
        esac
    done

    printf '%s\n' "__DONE__" >&3
    exec 3>&-
    wait "$workerPid"
}


# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Check if case can be resumed
bResume=false
if ${bParallel}; then
    if [ -d processor0 ] && ls -d processor0/[0-9]* 2>/dev/null | grep -q -v "/0$"; then
        bResume=true
    fi
else
    if ls -d [0-9]* 2>/dev/null | grep -q -v "^0$"; then
        bResume=true
    fi
fi

if ${bResume}; then
    echo "Found existing time directories. Resuming simulation..."
else
    echo "Copying 'initial' to 0"
    cp -r initial 0

    # remove `.orig` extensions where applicable
    find 0 -name "*.orig" -exec bash -c 'cp "$0" "${0%.orig}"' {} \;

    runApplication blockMesh
    runApplication setFields
fi

if ${bParallel}; then
    if ! ${bResume}; then
        decomposePar 2>&1 | tee log.decomposePar
    fi

    nCores=$(\
        foamDictionary -entry numberOfSubdomains \
                       -value system/decomposeParDict)

    if ${convertVTK}; then
        mpirun --oversubscribe -np $nCores \
            laserbeamFoam \
            -parallel \
            2>&1 | convertOnWrite | tee log.laserbeamFoam
    else
        mpirun --oversubscribe -np $nCores \
            laserbeamFoam \
            -parallel \
            2>&1 | tee log.laserbeamFoam
    fi
else
    if ${convertVTK}; then
        laserbeamFoam 2>&1 | convertOnWrite | tee log.laserbeamFoam
    else
        laserbeamFoam 2>&1 | tee log.laserbeamFoam
    fi
fi

touch cunninghamValidation.foam
