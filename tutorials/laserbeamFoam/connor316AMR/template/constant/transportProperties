FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Interface tracking method: isoAdvector or MULES
interfaceTrackingScheme MULES;

phases          (metal gas);

metal
{
    transportModel  Newtonian;     // Viscosity model for the metal phase
    nu              7e-7;          // Kinematic viscosity [m2/s]

    rho             7904;          // Density [kg/m3]

    Tsolidus 1658;                 // Solidus temperature [K]
    Tliquidus 1723;                // Liquidus temperature [K]
    LatentHeat 260e3;              // Latent heat of fusion [J/kg]
    beta    1.8e-5;                // Thermal expansion coefficient [1/K]

    table_kappa                    // Metal thermal conductivity table: (T [K], kappa [W/m/K])
    (
        (300    14.68)
        (500    17.60)
        (800    21.98)
        (1200   27.82)
        (1658   34.51)
        (1723   26.90)
        (2500   26.90)
        (5000   26.90)
    );

    table_cp                       // Metal specific heat table: (T [K], cp [J/kg/K])
    (
        (300    492.8)
        (500    540.8)
        (800    612.8)
        (1200   708.8)
        (1658   818.7)
        (1723   790.0)
        (2500   790.0)
        (5000   790.0)
    );

    elec_resistivity	1.2e-6;        // Electrical resistivity [ohm m]; calibrated (50um mesh, score 7.79); coarse 125um best was 2.45e-6
}

gas
{
    transportModel  Newtonian;     // Viscosity model for the gas phase

    nu              1.48e-05;      // Kinematic viscosity [m2/s]

    rho             1;             // Density [kg/m3]

    poly_kappa   (0.04 0 0 0 0 0 0 0);       // Gas thermal conductivity polynomial [W/m/K]
    poly_cp   (520 0.0 0 0 0 0 0 0);         // Gas specific heat polynomial [J/kg/K]

    Tsolidus    1.0;              // Dummy gas solidus temperature [K]
    Tliquidus   10.0;             // Dummy gas liquidus temperature [K]
    LatentHeat  1;                // Dummy gas latent heat [J/kg]
    beta    4.0e-5;               // Gas thermal expansion coefficient [1/K]
}

emS                         0.26;       // Solid emissivity [-]
emL                         0.26;       // Liquid emissivity [-]
TRef                        300;        // Radiation reference/background temperature [K]
T_ambient                   300;        // Ambient temperature for convection [K]
h_convection                0;          // Convective heat transfer coefficient [W/m2/K]

sigma            1.8;            // Surface tension [N/m]
Marangoni_Constant	-4.9e-4;    // d(sigma)/dT for Marangoni force [N/m/K]
p0	101325.0;                    // Atmospheric pressure reference [Pa]
p_amb   1e-3;                 // Ambient chamber pressure used to choose Tvap [Pa]
beta_r  0.18;                    // Recoil pressure accommodation coefficient [-]
Tvap	2379;                    // Vaporization temperature at p_amb [K]
Tvap_atm    3134;                // Vaporization temperature at p0 [K]
recoilPressureModel condensation; // condensation or modifiedReducedPressure
recoilTransitionWidth       100; // Smooth recoil activation width above Tvap [K]
Mm	0.055;                       // Molar mass [kg/mol]
LatentHeatVap 6.33e6;            // Latent heat of vaporization [J/kg]

LeeCoeff        0;              // Lee volumetric evaporation coeff [1/s]
                                // 0 = disabled (interface Qv only)
                                // 1e5 = moderate clamp (~300 K overshoot)
                                // 1e7 = tight clamp (~30 K overshoot)
                                // Derived from kinetic theory (Lee 1980; Chen+ 2020)

// ************************************************************************* //
