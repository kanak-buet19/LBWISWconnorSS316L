FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1.0;

// Zhang et al. (2024) 316L bare-plate single-track domain.
// x = cross-track, y = depth (y=0=top/atmosphere, y=max=lowerWall), z = scan.
// Base cell size: 20 um (uniform). AMR refines 2 levels -> 5 um near melt pool.
//   x: 0.800 mm  (40 cells — laser at x=400 um center, ±8 beam radii)
//   y: 0.500 mm  (25 cells — 100 um gas + 400 um substrate)
//   z: 1.200 mm  (60 cells — 200 um lead-in + 800 um track + 200 um lag)

vertices
(
    (0         0         0        )  // 0
    (800e-6    0         0        )  // 1
    (800e-6    500e-6    0        )  // 2
    (0         500e-6    0        )  // 3
    (0         0         1200e-6  )  // 4
    (800e-6    0         1200e-6  )  // 5
    (800e-6    500e-6    1200e-6  )  // 6
    (0         500e-6    1200e-6  )  // 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (40 25 60) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    lowerWall
    {
        type wall;
        faces
        (
            (3 7 6 2)
        );
    }

    atmosphere
    {
        type patch;
        faces
        (
            (1 5 4 0)
        );
    }

    rightWall
    {
        type patch;
        faces
        (
            (1 2 6 5)
        );
    }

    leftWall
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }

    frontAndBack
    {
        type patch;
        faces
        (
            (0 3 2 1)
            (5 6 7 4)
        );
    }
);

mergePatchPairs
(
);

