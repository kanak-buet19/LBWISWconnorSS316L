FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Domain: x=0..800um, y=0..500um (y=0=top/atmosphere), z=0..1200um
// Gas layer: y=0..100um
// Metal substrate: y=100um..500um (400um depth)

defaultFieldValues
(
    volScalarFieldValue alpha.metal 0
);

regions
(
    boxToCell
    {
        box (0 100e-6 0) (800e-6 500e-6 1200e-6);
        fieldValues
        (
            volScalarFieldValue alpha.metal 1
        );
    }
);


