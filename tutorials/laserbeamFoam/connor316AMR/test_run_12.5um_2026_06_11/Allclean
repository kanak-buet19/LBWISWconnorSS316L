#!/bin/bash

caseDir="$(cd "$(dirname "$0")" && pwd)"
cd "$caseDir"

# Time directories
rm -rf [1-9]* 0.*

# Parallel decomposition
rm -rf processor*

# Mesh (regenerated by blockMesh)
rm -rf constant/polyMesh

# OpenFOAM logs
rm -f log.*

# Residual plots and data
rm -rf residuals/

# ParaView/foam file
rm -f *.foam

# VTK output (ray paths + converted time dirs)
rm -rf VTK/ VTKs/

# Post-processing data
rm -rf absorptivity_vs_time/ post-processing-data/

# Reconstructed time dir (0 rebuilt from initial by Allrun)
rm -rf 0

# Python cache
find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null
find . -name "*.pyc" -delete 2>/dev/null

echo "Case cleaned."
