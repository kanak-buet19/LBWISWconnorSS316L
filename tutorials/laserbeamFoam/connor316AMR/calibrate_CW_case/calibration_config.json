{
  "_comment": "Single-case Hofmann 316L calibration using the current validation analyzer. Target case: 200 W, 900 mm/s, 25 um beam radius. Base mesh is 20 um; maxRefinement=2 gives 5 um finest cells.",

  "objective": {
    "_comment": "Case error = mean absolute relative error over depth, width, and aspect ratio. Lower is better.",
    "metric": "mean_abs_rel_error_with_ar",
    "depth_weight": 1.0,
    "width_weight": 1.0
  },

  "mesh_phases": {
    "enabled": false,
    "_comment": "Disabled for this validation calibration: every candidate runs at 20 um base with maxRefinement=2 -> 5 um finest cells."
  },

  "optimizer": {
    "method": "bo_tpe",
    "nSamples": 96,
    "initSamples": 24,
    "seed": 42,
    "_comment": "Bayesian optimization (Optuna TPE) with an initial Latin-Hypercube design."
  },

  "parameters": {
    "_comment": "Active 316L thermophysical knobs. table_cp_scale and table_kappa_scale multiply every metal table row, preserving table shape.",
    "nu":                  {"type": "scalar", "baseline": 1.1626e-6, "min": 1.04634e-6, "max": 1.27886e-6, "_units": "m2/s"},
    "rho":                 {"type": "scalar", "baseline": 7900.0,   "min": 7110.0,     "max": 8690.0,     "_units": "kg/m3"},
    "table_kappa_scale":   {"type": "scale",  "baseline": 1.0,      "min": 0.90,       "max": 1.10,       "_units": "-"},
    "table_cp_scale":      {"type": "scale",  "baseline": 1.0,      "min": 0.90,       "max": 1.10,       "_units": "-"},
    "elec_resistivity":    {"type": "scalar", "baseline": 0.95e-6,  "min": 0.855e-6,   "max": 1.045e-6,   "_units": "ohm m"},
    "sigma":               {"type": "scalar", "baseline": 1.76,     "min": 1.584,      "max": 1.936,      "_units": "N/m"},
    "Marangoni_Constant":  {"type": "scalar", "baseline": -4.9e-4,  "min": -5.39e-4,   "max": -4.41e-4,   "_units": "N/m/K"},
    "LatentHeatVap":       {"type": "scalar", "baseline": 6.336e6,  "min": 5.7024e6,   "max": 6.9696e6,   "_units": "J/kg"}
  },

  "geometry": {
    "base_cell": 20e-6,
    "gas_thickness": 120e-6,
    "x_extent": 280e-6,
    "lead_in": 100e-6,
    "tail": 200e-6,
    "substrate_depth_factor": 1.5,
    "substrate_min": 140e-6,
    "surface_y_um": 120.0
  },

  "control": {
    "endTime": 1.1666666666666668e-3,
    "writeInterval": 1e-5,
    "deltaT": 1e-7,
    "maxDeltaT": 1e-6,
    "maxCo": 0.75,
    "maxAlphaCo": 0.75
  },

  "cases": [
    {
      "name": "hofmann_scantrack_200W_900mms_r25um",
      "P_laser_W": 200,
      "v_scan_mm_s": 900,
      "laserRadius_m": 25e-6,
      "laser_start_z_m": 0.000100,
      "laser_end_z_m": 0.000700,
      "laser_off_time_s": 6.666666666666667e-4,
      "end_time_s": 1.1666666666666668e-3,
      "exp_width_um": 114.6025,
      "exp_depth_um": 93.9525
    }
  ],

  "earlyAbort": {
    "enabled": false,
    "errorThreshold": 0.45,
    "stabilityTol": 0.10,
    "minPoints": 3,
    "skipSecondCaseIfFirstBad": false,
    "_comment": "Disabled because in-run melt-pool/final-section files are provisional. Score only after the solver exits."
  },

  "cleanup": {
    "enabled": true,
    "_comment": "Keep full heavy data only for the current best valid candidate. Other completed candidates keep CSV, logs, case_build.json, result.json, and case_info.json."
  },

  "longTrackValidation": {
    "enabled": false
  },

  "execution": {
    "coresPerSim": 8,
    "totalCores": 36,
    "pollIntervalSec": 10,
    "perSimStallSec": 1800,
    "perSimStartupSec": 3600,
    "minDeltaTAbort": 0,
    "minDeltaTConsecutivePolls": 5,
    "lowDeltaTPenalty": 1.0
  }
}
