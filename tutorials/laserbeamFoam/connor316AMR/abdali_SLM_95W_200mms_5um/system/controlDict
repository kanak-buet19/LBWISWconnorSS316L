FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     laserbeamFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         5.0e-3;

deltaT          1e-7;

writeControl    runTime;

writeInterval   2e-4;

purgeWrite      0;

writeFormat     ascii;

writePrecision  10;

writeCompression uncompressed;

timeFormat      general;

timePrecision   10;

runTimeModifiable no;

adjustTimeStep  yes;

maxCo           0.35;
maxAlphaCo      0.35;

maxDeltaT       1e-6;

debugNumerics              false;
debugNumericsInterval      25;
debugNumericsSmallDeltaT   5e-8;
debugNumericsSmallDeltaTInterval 5;
debugNumericsCoFraction    0.95;

// ************************************************************************* //
