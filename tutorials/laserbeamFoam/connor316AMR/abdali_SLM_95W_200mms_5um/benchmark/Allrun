#!/bin/bash
# Wrapper to source OpenFOAM environment and run the python benchmark script

# Source OpenFOAM environment if command blockMesh is not already on PATH
if ! command -v blockMesh &> /dev/null; then
    if [ -f /usr/lib/openfoam/openfoam2412/etc/bashrc ]; then
        set +e
        source /usr/lib/openfoam/openfoam2412/etc/bashrc
        set -e
    elif [ -f /openfoam/bash.rc ]; then
        set +e
        source /openfoam/bash.rc
        set -e
    else
        echo "ERROR: OpenFOAM commands not found on PATH and no bashrc found to source."
        exit 1
    fi
fi

# Run the benchmark orchestrator script
caseDir="$(cd "$(dirname "$0")" && pwd)"
export PYTHON="${PYTHON:-/home/kanak/.venv/venv314/bin/python}"
"$PYTHON" "$caseDir/run_benchmark.py" "$@"

# Display the summary to the console
if [ -f "$caseDir/benchmark_summary.md" ]; then
    echo -e "\n"
    cat "$caseDir/benchmark_summary.md"
fi
