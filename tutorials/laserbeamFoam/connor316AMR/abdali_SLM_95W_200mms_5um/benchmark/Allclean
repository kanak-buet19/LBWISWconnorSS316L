#!/bin/bash
# Clean script for the benchmark directory
set -e

caseDir="$(cd "$(dirname "$0")" && pwd)"
cd "$caseDir"

echo "[CLEAN] Cleaning benchmark directories and logs..."

# Remove run directories
rm -rf run_4W run_8W run_16W run_24W run_32W run_*W

# Remove scaling results, reports, and plots
rm -f benchmark_results.json
rm -f benchmark_scaling.png
rm -f benchmark_summary.md

# Remove SLURM output and error logs
rm -f output_*.out output_*.err

# Remove config cache folders
rm -rf .mplconfig

echo "[CLEAN] Benchmark directory cleaned successfully."
