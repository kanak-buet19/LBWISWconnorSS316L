FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     laserbeamFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         7.45556e-4;  // 0.55556 ms track + 0.19 ms cooldown

deltaT          1e-7;

writeControl    runTime;

writeInterval   5e-5;    // ~22 writes over 1.1 ms track (45 um scan per write)

purgeWrite      0;

writeFormat     ascii;

writePrecision  10;

writeCompression uncompressed;

timeFormat      general;

timePrecision   10;

runTimeModifiable no;

adjustTimeStep  yes;

maxCo           0.35;
maxAlphaCo      0.35;

maxDeltaT       1e-6;

debugNumerics              false;
debugNumericsInterval      25;
debugNumericsSmallDeltaT   5e-8;
debugNumericsSmallDeltaTInterval 5;
debugNumericsCoFraction    0.95;

// ************************************************************************* //
