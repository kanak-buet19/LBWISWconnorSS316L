#!/bin/bash

set -e
set -o pipefail

## Notes:
# has dynamic meshing; 8 core job
# In future could also test with `blastAMR`

# User options:
bParallel=true # Only set to false for debugging purposes.
convertVTK=true # Convert written times to legacy VTK during the solver run.
analyzeMeltpool=true # Analyze each newly converted legacy VTK during the solver run.
pythonExe="${PYTHON:-python3}"

writeSettleTimeout=600 # Max seconds to wait for a parallel write to land on disk.
writeSettleAttempts=3  # Reconstruct/convert attempts per written time.

latestInternalVTK()
{
    find VTK -maxdepth 1 -type f -name "*.vtk" -printf '%T@ %p\n' 2>/dev/null \
        | sort -g \
        | tail -1 \
        | cut -d' ' -f2-
}

# Size + file-count fingerprint of every processor*/<time> tree. Empty if none exist.
writeFootprint()
{
    local timeName="$1"

    find processor*/"${timeName}" -type f -printf '%s\n' 2>/dev/null \
        | awk '{n++; s+=$1} END {if (n) print n"/"s}'
}

# Block until every processor has written <time> and the trees stop growing.
# The solver prints "Writing ..." when the write *starts*; with AMR each write
# also dumps a per-processor polyMesh, so a fixed sleep is not enough.
waitForCompleteWrite()
{
    local timeName="$1"
    local deadline=$((SECONDS + writeSettleTimeout))
    local nProcs=0
    local nReady=0
    local prev=""
    local cur=""

    nProcs=$(find . -maxdepth 1 -type d -name 'processor*' | wc -l)
    if [ "$nProcs" -eq 0 ]; then
        sleep 2 # Serial run: nothing to synchronise across.
        return 0
    fi

    while [ "$SECONDS" -lt "$deadline" ]
    do
        nReady=$(find processor*/"${timeName}" -maxdepth 0 -type d 2>/dev/null | wc -l)
        if [ "$nReady" -eq "$nProcs" ]; then
            break
        fi
        sleep 1
    done

    if [ "$nReady" -ne "$nProcs" ]; then
        echo "[WARNING] Only ${nReady}/${nProcs} processors wrote time ${timeName} within ${writeSettleTimeout}s." >&4
        return 1
    fi

    # Two identical footprints one second apart means the flush is done.
    while [ "$SECONDS" -lt "$deadline" ]
    do
        cur="$(writeFootprint "$timeName")"
        if [ -n "$cur" ] && [ "$cur" = "$prev" ]; then
            return 0
        fi
        prev="$cur"
        sleep 1
    done

    echo "[WARNING] Write of time ${timeName} still growing after ${writeSettleTimeout}s; converting anyway." >&4
    return 0
}

postProcessWrittenTime()
{
    local timeName="$1"
    local vtkFile=""
    local attempt=1

    echo "[DEBUG] Post-processing output time step ${timeName}..."

    while true
    do
        if ./foamVTK.sh "$timeName"; then
            break
        fi

        if [ "$attempt" -ge "$writeSettleAttempts" ]; then
            echo "[WARNING] foamVTK.sh failed for time step ${timeName} after ${attempt} attempts; solver will continue." >&4
            return 0
        fi

        echo "[DEBUG] foamVTK.sh failed for ${timeName} (attempt ${attempt}); re-checking write and retrying..."
        attempt=$((attempt + 1))
        sleep 5
        waitForCompleteWrite "$timeName" || true
    done

    if ${analyzeMeltpool}; then
        vtkFile="$(latestInternalVTK)"

        if [ -z "$vtkFile" ]; then
            echo "[WARNING] No legacy internal-mesh .vtk found after converting time step ${timeName}; solver will continue." >&4
            return 0
        fi

        echo "[DEBUG] Running meltpool analysis on ${vtkFile}..."
        MPLCONFIGDIR="${MPLCONFIGDIR:-/tmp}" "$pythonExe" \
            scripts/analyze_meltpool_vtu.py \
            --vtk-file "$vtkFile" \
            --surface-y-um 128 \
            || { echo "[WARNING] Meltpool analysis failed for ${vtkFile}; solver will continue." >&4; return 0; }
        echo "[DEBUG] Meltpool analysis completed successfully for ${vtkFile}."
    fi
}

postProcessQueueWorker()
{
    local queueFile="$1"
    local queuedTime=""

    while IFS= read -r queuedTime
    do
        if [ "$queuedTime" = "__DONE__" ]; then
            break
        fi

        # reconstructParMesh must not run before the solver has flushed every
        # processor*/<time> directory to disk.
        waitForCompleteWrite "$queuedTime" || true
        postProcessWrittenTime "$queuedTime"
    done < "$queueFile"
}

convertOnWrite()
{
    local currentTime=""
    local lastProcessedTime=""
    local queueFile=""
    local workerPid=""

    queueFile="$(mktemp -u ".postProcessQueue.XXXXXX")"
    mkfifo "$queueFile"
    exec 4>&2
    postProcessQueueWorker "$queueFile" >> log.postProcess 2>&1 &
    workerPid="$!"
    exec 3>"$queueFile"
    rm -f "$queueFile"

    while IFS= read -r line
    do
        echo "$line"

        case "$line" in
            "Time = "*)
                currentTime="${line#Time = }"
                ;;
            "Writing "*|"Writing data at time "*)
                if [ -n "$currentTime" ] && [ "$currentTime" != "$lastProcessedTime" ]; then
                    echo "Queueing VTK conversion for time ${currentTime}"
                    printf '%s\n' "$currentTime" >&3
                    lastProcessedTime="$currentTime"
                fi
                ;;
        esac
    done

    printf '%s\n' "__DONE__" >&3
    exec 3>&-
    wait "$workerPid"
    exec 4>&-
}


# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Check if case can be resumed
bResume=false
if ${bParallel}; then
    if [ -d processor0 ] && ls -d processor0/[0-9]* 2>/dev/null | grep -q -v "/0$"; then
        bResume=true
    fi
else
    if ls -d [0-9]* 2>/dev/null | grep -q -v "^0$"; then
        bResume=true
    fi
fi

if ${bResume}; then
    echo "[DEBUG] Found existing time directories. Resuming simulation..."
    if [ ! -d constant/polyMesh ]; then
        echo "[DEBUG] Base mesh constant/polyMesh is missing. Re-running blockMesh..."
        blockMesh >> log.blockMesh 2>&1 || { echo "[ERROR] blockMesh failed during resume! Exiting."; exit 1; }
        echo "[DEBUG] blockMesh completed successfully."
    fi
else
    echo "[DEBUG] Cleaning old post-processing logs..."
    rm -f log.postProcess
    echo "[DEBUG] Copying 'initial' to 0..."
    cp -r initial 0 || { echo "[ERROR] Failed to copy initial to 0. Exiting."; exit 1; }

    # remove `.orig` extensions where applicable
    find 0 -name "*.orig" -exec bash -c 'cp "$0" "${0%.orig}"' {} \;

    echo "[DEBUG] Running blockMesh..."
    blockMesh >> log.blockMesh 2>&1 || { echo "[ERROR] blockMesh failed! Exiting."; exit 1; }
    echo "[DEBUG] blockMesh completed successfully."

    echo "[DEBUG] Running setFields..."
    setFields >> log.setFields 2>&1 || { echo "[ERROR] setFields failed! Exiting."; exit 1; }
    echo "[DEBUG] setFields completed successfully."
fi

appendFlag=""
if ${bResume}; then
    appendFlag="--append"
fi

if ${bParallel}; then
    if ! ${bResume}; then
        echo "[DEBUG] Decomposing mesh using decomposePar..."
        decomposePar > log.decomposePar 2>&1 || { echo "[ERROR] decomposePar failed! Exiting."; exit 1; }
        echo "[DEBUG] Decomposing mesh completed successfully."
    fi

    nCores=$(\
        foamDictionary -entry numberOfSubdomains \
                       -value system/decomposeParDict)

    echo "[DEBUG] Starting laserbeamFoam in parallel on $nCores cores..."
    if ${convertVTK}; then
        mpirun --oversubscribe -np $nCores \
            laserbeamFoam \
            -parallel \
            2>&1 | convertOnWrite | "$pythonExe" scripts/parse_simulation_log.py ${appendFlag} || { echo "[ERROR] Parallel simulation failed! Exiting."; exit 1; }
    else
        mpirun --oversubscribe -np $nCores \
            laserbeamFoam \
            -parallel \
            2>&1 | "$pythonExe" scripts/parse_simulation_log.py ${appendFlag} || { echo "[ERROR] Parallel simulation failed! Exiting."; exit 1; }
    fi
else
    echo "[DEBUG] Starting laserbeamFoam in single-processor mode..."
    if ${convertVTK}; then
        laserbeamFoam 2>&1 | convertOnWrite | "$pythonExe" scripts/parse_simulation_log.py ${appendFlag} || { echo "[ERROR] Simulation failed! Exiting."; exit 1; }
    else
        laserbeamFoam 2>&1 | "$pythonExe" scripts/parse_simulation_log.py ${appendFlag} || { echo "[ERROR] Simulation failed! Exiting."; exit 1; }
    fi
fi
echo "[DEBUG] Simulation completed successfully."

touch cunninghamValidation.foam
