FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1.0;

// CW single-track 316L bareplate validation (Hofmann 2026).
// P=200W, v=900mm/s, d_laser=0.05mm. Target: depth~200um, width~115um.
// x=cross-track, y=depth (y=0=top/atmosphere), z=scan direction.
// Base 32 um; 2-level AMR -> 8 um near melt pool.
//   x: 0.512 mm  (26 cells)
//   y: 0.363 mm  (18 cells)
//   z: 1.500 mm  (75 cells)

vertices
(
    (0         0         0        )  // 0
    (0.512e-3  0         0        )  // 1
    (0.512e-3  0.363e-3  0        )  // 2
    (0         0.363e-3  0        )  // 3
    (0         0         1.500e-3 )  // 4
    (0.512e-3  0         1.500e-3 )  // 5
    (0.512e-3  0.363e-3  1.500e-3 )  // 6
    (0         0.363e-3  1.500e-3 )  // 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (26 18 75) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    lowerWall
    {
        type wall;
        faces
        (
            (3 7 6 2)
        );
    }

    atmosphere
    {
        type patch;
        faces
        (
            (1 5 4 0)
        );
    }

    rightWall
    {
        type patch;
        faces
        (
            (1 2 6 5)
        );
    }

    leftWall
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }

    frontAndBack
    {
        type patch;
        faces
        (
            (0 3 2 1)
            (5 6 7 4)
        );
    }
);

mergePatchPairs
(
);

