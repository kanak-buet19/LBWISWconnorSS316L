FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     laserbeamFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         1.65e-3;  // 1.3 mm track at 900 mm/s = 1.444 ms + 0.2 ms cooldown

deltaT          1e-8;

writeControl    runTime;

writeInterval   1e-5;    // 0.01 ms interval: catch stabilization curve

purgeWrite      0;

writeFormat     ascii;

writePrecision  10;

writeCompression uncompressed;

timeFormat      general;

timePrecision   10;

runTimeModifiable no;

adjustTimeStep  yes;

maxCo           0.6;
maxAlphaCo      0.6;

maxDeltaT       5e-7;

debugNumerics              false;
debugNumericsInterval      25;
debugNumericsSmallDeltaT   5e-8;
debugNumericsSmallDeltaTInterval 5;
debugNumericsCoFraction    0.95;

functions
{
    fieldStats
    {
        type        fieldMinMax;
        libs        (fieldFunctionObjects);
        fields      (T pVap);
        location    no;
        writeToFile no;
        log         yes;
    }
}

