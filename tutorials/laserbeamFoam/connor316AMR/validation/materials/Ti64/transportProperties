FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Material: Ti-6Al-4V
// Reference: Wang et al., npj Computational Materials (2022) 8:22
// Case 4: P=382W, v=475mm/s, d_laser=0.10mm, atmospheric pressure.

// Interface tracking method: isoAdvector or MULES
interfaceTrackingScheme MULES;

phases          (metal gas);

metal
{
    transportModel  Newtonian;
    nu              1.136e-6;      // Kinematic viscosity [m2/s]  (mu=0.005 Pa.s / rho=4400 kg/m3)

    rho             4400;          // Density [kg/m3]

    Tsolidus        1878;          // Solidus temperature [K]
    Tliquidus       1928;          // Liquidus temperature [K]
    LatentHeat      2.86e5;        // Latent heat of fusion [J/kg]
    beta            1.1e-5;        // Thermal expansion coefficient [1/K]

    // kappa: solid 16 W/m/K, liquid 32 W/m/K (step jump at liquidus)
    table_kappa
    (
        (300    19.0)
        (1268   19.0)
        (1500   25.2)
        (1700   27.8)
        (1878   27.5)
        (1923   27.3)
        (1924   33.4)
        (1973   33.4)
        (1974   34.6)
        (3315   34.6)
        (5000   34.6)
    );

    // cp: solid 570 J/kg/K, liquid 831 J/kg/K (step jump at liquidus)
    table_cp
    (
        (300    411.5)
        (1268   411.5)
        (1269   666.0)
        (1500   712.6)
        (1700   752.9)
        (1878   788.9)
        (1923   797.9)
        (1924   830.0)
        (3315   830.0)
        (5000   830.0)
    );
    elec_resistivity   9.9e-7;      // Electrical resistivity [ohm m] (placeholder)
}

gas
{
    transportModel  Newtonian;     // Viscosity model for the gas phase

    nu              1.48e-05;      // Kinematic viscosity [m2/s]

    rho             1;             // Density [kg/m3]

    poly_kappa   (0.04 0 0 0 0 0 0 0);       // Gas thermal conductivity polynomial [W/m/K]
    poly_cp   (520 0.0 0 0 0 0 0 0);         // Gas specific heat polynomial [J/kg/K]

    Tsolidus    1.0;              // Dummy gas solidus temperature [K]
    Tliquidus   10.0;             // Dummy gas liquidus temperature [K]
    LatentHeat  1;                // Dummy gas latent heat [J/kg]
    beta    4.0e-5;               // Gas thermal expansion coefficient [1/K]
}

emS                         0.4;       // Solid emissivity (Wang 2022: epsilon=0.4)
emL                         0.4;       // Liquid emissivity (Wang 2022: epsilon=0.4)
TRef                        300;        // Radiation reference/background temperature [K]
T_ambient                   300;        // Ambient temperature for convection [K]
h_convection                0;          // Convective heat transfer coefficient [W/m2/K]

sigma            1.68;            // Surface tension at liquidus [N/m] original 1.68
Marangoni_Constant  -2.6e-4;     // d(sigma)/dT [N/m/K]
p0          101325.0;             // Atmospheric pressure reference [Pa]
p_amb       101325.0;             // Ambient chamber pressure used to choose Tvap [Pa]
recoil_coeff    0.54;             // Clausius-Clapeyron recoil prefactor [-]
Tvap            3133;             // Boiling temperature at 1 atm [K]
Tvap_atm        3133;             // Boiling temperature at p0 [K]
recoilPressureModel condensation; // condensation or modifiedReducedPressure
recoilTransitionWidth       10;   // Smooth recoil activation width above Tvap [K]
Mm              0.04674;          // Molar mass [kg/mol]  (Ti6Al4V alloy average)
LatentHeatVap   9.70e6;          // Latent heat of vaporization [J/kg]

LeeCoeff        1e2;               // Lee volumetric evaporation coeff [1/s] — gentle T ceiling, prevents table extrapolation above 5000K
T_recoil_cap    5000;             // K — cap on T fed to CC recoil formula; tune to match keyhole depth

V_scan          0.475;           // Scan speed (475 mm/s)
scanDirection   (0 0 1);        // Scanning along +Z direction

// ---- Vapor plume Beer-Lambert attenuation (Yang et al. 2026 IJHMT, Eq. 31-35) ----
vaporPlumeAttenuation   true;
muAlphaMax              310;        // [1/m]    Yang et al. 2026
pVaporMax               1e-8;       // [Pa·m³]  calibrate vs keyhole depth at one reference case (Original 1e-7)
H_plume                 1e-3;       // [m]      Yang et al. 2026
uMax                    1.5;        // [m/s]    Yang et al. 2026

// ************************************************************************* //
