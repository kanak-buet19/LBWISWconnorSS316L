FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Interface tracking method: isoAdvector or MULES
interfaceTrackingScheme MULES;

phases          (metal gas);

metal
{
    transportModel  Newtonian;     // Viscosity model for the metal phase
    nu              1.1626e-6;     // Kinematic viscosity [m2/s]

    rho             6881;          // Density [kg/m3]

    Tsolidus 1658;                 // Solidus temperature [K]
    Tliquidus 1723;                // Liquidus temperature [K]
    LatentHeat 260e3;              // Latent heat of fusion [J/kg]
    beta    1.8e-5;                // Thermal expansion coefficient [1/K]

    table_kappa
    (
        (300    14.68)    // 0.0146×300 + 10.3 = 14.68 ✓
        (500    17.60)    // 0.0146×500 + 10.3 = 17.60 ✓
        (800    21.98)    // 0.0146×800 + 10.3 = 21.98 ✓
        (1200   27.82)    // 0.0146×1200 + 10.3 = 27.82 ✓
        (1658   34.51)    // 0.0146×1658 + 10.3 = 34.51 ← fix this
        (1723   35.46)    // 0.0146×1723 + 10.3 = 35.46 ← add this point
        (1724   26.90)    // jump to liquid value at liquidus ← fix this
        (5000   26.90) 
        (10000   26.90)    // flat in liquid
    );

    table_cp
    (
        (300    492.8)    // 0.24×300 + 420.8 = 492.8 ✓
        (500    540.8)    // 0.24×500 + 420.8 = 540.8 ✓
        (800    612.8)    // 0.24×800 + 420.8 = 612.8 ✓
        (1200   708.8)    // 0.24×1200 + 420.8 = 708.8 ✓
        (1658   818.7)    // 0.24×1658 + 420.8 = 818.7 ✓
        (1723   834.3)    // 0.24×1723 + 420.8 = 834.3 ← add this
        (1724   790.0)    // jump to liquid value ← fix this
        (5000   790.0)
        (10000   790.0)

    );
    elec_resistivity	5e-7;      // Electrical resistivity [ohm m]
}

gas
{
    transportModel  Newtonian;     // Viscosity model for the gas phase

    nu              1.48e-05;      // Kinematic viscosity [m2/s]

    rho             1;             // Density [kg/m3]

    poly_kappa   (0.04 0 0 0 0 0 0 0);       // Gas thermal conductivity polynomial [W/m/K]
    poly_cp   (520 0.0 0 0 0 0 0 0);         // Gas specific heat polynomial [J/kg/K]

    Tsolidus    1.0;              // Dummy gas solidus temperature [K]
    Tliquidus   10.0;             // Dummy gas liquidus temperature [K]
    LatentHeat  1;                // Dummy gas latent heat [J/kg]
    beta    4.0e-5;               // Gas thermal expansion coefficient [1/K]
}

emS                         0.3;       // Solid emissivity [-]
emL                         0.3;       // Liquid emissivity [-]
TRef                        300;        // Radiation reference/background temperature [K]
T_ambient                   300;        // Ambient temperature for convection [K]
h_convection                0;          // Convective heat transfer coefficient [W/m2/K]

sigma            1.87;            // Surface tension [N/m]
Marangoni_Constant	-4.9e-4;      // Stronger d(sigma)/dT test [N/m/K]
variableSurfaceTension  off;          // on: sigma(T) = sigma + Marangoni_Constant*(T - Tliquidus)
p0	101325.0;                    // Atmospheric pressure reference [Pa]
p_amb   101325.0;                 // Ambient chamber pressure used to choose Tvap [Pa]
recoil_coeff 0.54;               // Recoil pressure Clausius-Clapeyron prefactor [-]
Tvap	3122;                    // Vaporization temperature at p_amb [K]
Tvap_atm    3122;                // Vaporization temperature at p0 [K]
recoilPressureModel condensation; // condensation or modifiedReducedPressure
recoilTransitionWidth       10; // Smooth recoil activation width above Tvap [K]
Mm	0.056;                       // Molar mass [kg/mol]
LatentHeatVap 6.336e6;            // Latent heat of vaporization [J/kg]

LeeCoeff        1e2;              // Lee volumetric evaporation coeff [1/s] -- 1e4 for 10um mesh 

V_scan          0.9;            // Scan speed (900 mm/s)
scanDirection   (0 0 1);        // Scanning along +Z direction

// ---- Vapor plume Beer-Lambert attenuation (Yang et al. 2026 IJHMT, Eq. 31-35) ----
vaporPlumeAttenuation   false;
muAlphaMax              310;        // [1/m]    Yang et al. 2026
pVaporMax               1e-7;       // [Pa·m³]  calibrate vs keyhole depth at one reference case
H_plume                 1e-3;       // [m]      Yang et al. 2026
uMax                    1.5;        // [m/s]    Yang et al. 2026

// ************************************************************************* //
