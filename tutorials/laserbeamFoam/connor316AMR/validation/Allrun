#!/bin/bash

set -e

suiteDir="$(cd "$(dirname "$0")" && pwd)"
cd "$suiteDir"

if [ "$#" -eq 0 ]; then
    mapfile -t menuCases < <(python3 scripts/setup_cases.py --list-enabled)
    echo "Select case to run:"
    echo "  0) all"
    i=1
    for caseName in "${menuCases[@]}"; do
        echo "  ${i}) ${caseName}"
        i=$((i + 1))
    done
    printf "choice [0-%d] (space/comma separated ok): " "${#menuCases[@]}"
    read -r choice
    choice="${choice//,/ }"
    if [ -z "$choice" ]; then
        set -- --all
    else
        selectedArgs=()
        for item in $choice; do
            if [ "$item" = "0" ] || [ "$item" = "all" ]; then
                selectedArgs=(--all)
                break
            elif [[ "$item" =~ ^[0-9]+$ ]] && [ "$item" -ge 1 ] && [ "$item" -le "${#menuCases[@]}" ]; then
                selectedArgs+=(--case "${menuCases[$((item - 1))]}")
            else
                echo "Invalid choice: $item" >&2
                exit 2
            fi
        done
        set -- "${selectedArgs[@]}"
    fi
fi

# --setup-only/--list-enabled/--list are dev/tuning modes with no run and no
# batch context, so they keep the plain cases/<name>/ layout.
for arg in "$@"; do
    if [ "$arg" = "--setup-only" ] || [ "$arg" = "--list-enabled" ] || [ "$arg" = "--list" ]; then
        python3 scripts/setup_cases.py "$@"
        exit 0
    fi
done

mapfile -t caseNames < <(python3 scripts/setup_cases.py --list "$@")

# Every Allrun invocation gets ONE batch folder: cases/case_NNN_<date>_<time>/.
# setup_cases.py builds every selected case straight into that folder (via
# --dest-root) as cases/<batchName>/<caseName>/ -- no separate staging copy.
# NNN is a global counter across all past batches, so separate invocations
# never collide with each other.
runTimestamp="$(date +%Y%m%d_%H%M%S)"

nextBatchName()
{
    local maxN=0
    local n
    for d in cases/case_[0-9][0-9][0-9]_*; do
        [ -d "$d" ] || continue
        n="$(basename "$d" | sed -n 's/^case_\([0-9]\{3\}\)_.*/\1/p')"
        [ -n "$n" ] || continue
        n=$((10#$n))
        if [ "$n" -gt "$maxN" ]; then
            maxN="$n"
        fi
    done
    printf 'case_%03d_%s' "$((maxN + 1))" "$runTimestamp"
}

batchName="$(nextBatchName)"
echo "===== Batch: cases/${batchName} (${#caseNames[@]} case(s)) ====="

python3 scripts/setup_cases.py --dest-root "cases/${batchName}" "$@"

set_case_cores()
{
    local caseName="$1"
    local cores="$2"
    local dict="cases/${batchName}/${caseName}/system/decomposeParDict"

    python3 - "$dict" "$cores" <<'PY'
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
cores = sys.argv[2]
text = path.read_text()
new_text, count = re.subn(
    r"^numberOfSubdomains\s+\d+\s*;",
    f"numberOfSubdomains  {cores};",
    text,
    count=1,
    flags=re.MULTILINE,
)
if count != 1:
    raise SystemExit(f"numberOfSubdomains entry not found in {path}")
path.write_text(new_text)
PY
}

run_case()
{
    local caseName="$1"
    local cores="$2"

    set_case_cores "$caseName" "$cores"
    (
        cd "cases/${batchName}/${caseName}"
        echo "===== Running ${caseName} on ${cores} cores ====="
        ./Allrun
    )
}

run_batch()
{
    local startIndex="$1"
    local batchSize="$2"
    local cores="$3"
    local pids=()
    local names=()
    local results=()
    local monitorArgs=()
    local monitorPid=""
    local i=0
    local caseName=""
    local status=0

    echo
    echo "===== Starting wave: ${batchSize} case(s), ${cores} cores each ====="
    if [ "$batchSize" -eq 1 ]; then
        caseName="${caseNames[$startIndex]}"
        echo "  -> ${caseName}"
        run_case "$caseName" "$cores"
        echo "  OK: ${caseName}"
        return
    fi

    for ((i = 0; i < batchSize; i++)); do
        caseName="${caseNames[$((startIndex + i))]}"
        names+=("$caseName")
        monitorArgs+=(--case "${batchName}/${caseName}")
        echo "  -> ${caseName} (log: cases/${batchName}/${caseName}/log.validationAllrun)"
        run_case "$caseName" "$cores" > "cases/${batchName}/${caseName}/log.validationAllrun" 2>&1 &
        pids+=("$!")
    done

    python3 scripts/monitor_case_progress.py --cores "$cores" --interval 2 "${monitorArgs[@]}" &
    monitorPid="$!"

    for ((i = 0; i < batchSize; i++)); do
        if wait "${pids[$i]}"; then
            results[$i]=0
        else
            results[$i]=1
            status=1
        fi
    done

    kill "$monitorPid" 2>/dev/null || true
    wait "$monitorPid" 2>/dev/null || true
    echo

    for ((i = 0; i < batchSize; i++)); do
        if [ "${results[$i]}" -eq 0 ]; then
            echo "  OK: ${names[$i]}"
        else
            echo "  FAILED: ${names[$i]} (see cases/${batchName}/${names[$i]}/log.validationAllrun)" >&2
        fi
    done

    if [ "$status" -ne 0 ]; then
        exit "$status"
    fi
}

totalCases="${#caseNames[@]}"
index=0
while [ "$index" -lt "$totalCases" ]; do
    remaining=$((totalCases - index))
    if [ "$remaining" -ge 4 ]; then
        run_batch "$index" 4 4
        index=$((index + 4))
    elif [ "$remaining" -eq 3 ]; then
        run_batch "$index" 2 8
        index=$((index + 2))
    elif [ "$remaining" -eq 2 ]; then
        run_batch "$index" 2 8
        index=$((index + 2))
    else
        run_batch "$index" 1 8
        index=$((index + 1))
    fi
done
