FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// ************************************************************************* //

// Interface tracking method: isoAdvector or MULES
interfaceTrackingScheme MULES;

phases          (metal gas);


// ------------------------------------------------------------------------- //
// Metal: SS316 / SS316L
// kappa(T) = 0.0146*T + 10.3 for T < 1723 K; 26.9 above liquidus.
// cp(T)    = 0.24*T + 420.8 for T < 1723 K; 790 above liquidus.
// Density is kept at the liquid value used by the current solver setup.
// ------------------------------------------------------------------------- //

metal
{
    transportModel      Newtonian;

    rho                 6881;          // Density [kg/m3]
    nu                  1.16262171e-6; // Kinematic viscosity [m2/s] = 8e-3 Pa.s / rho

    Tsolidus            1658;          // Solidus temperature [K]
    Tliquidus           1723;          // Liquidus temperature [K]
    LatentHeat          260e3;         // Latent heat of fusion [J/kg]
    beta                1.8e-5;        // Thermal expansion coefficient [1/K]

    table_kappa
    (
        (300      14.68)
        (500      17.6)
        (800      21.98)
        (1200     27.82)
        (1500     32.2)
        (1658     34.5068)
        (1722.999 35.4557854)
        (1723     26.9)
        (5000     26.9)
        (10000    26.9)
    );

    table_cp
    (
        (300      492.8)
        (500      540.8)
        (800      612.8)
        (1200     708.8)
        (1500     780.8)
        (1658     818.72)
        (1722.999 834.31976)
        (1723     790.0)
        (5000     790.0)
        (10000    790.0)
    );

    elec_resistivity    9.5e-07;          // Electrical resistivity [ohm m]
}


// ------------------------------------------------------------------------- //
// Gas: shielding atmosphere
// ------------------------------------------------------------------------- //

gas
{
    transportModel      Newtonian;

    rho                 1;             // Density [kg/m3]
    nu                  1.40e-05;      // Kinematic viscosity [m2/s]

    poly_kappa          (0.018 0 0 0 0 0 0 0); // Thermal conductivity [W/m/K]
    poly_cp             (520 0.0 0 0 0 0 0 0);   // Specific heat [J/kg/K]

    Tsolidus            1.0;           // Dummy solidus temperature [K]
    Tliquidus           10.0;          // Dummy liquidus temperature [K]
    LatentHeat          1;             // Dummy latent heat [J/kg]
    beta                4.0e-5;        // Thermal expansion coefficient [1/K]
}


// ------------------------------------------------------------------------- //
// Radiation and convection
// ------------------------------------------------------------------------- //

emS                     0.3;           // Solid emissivity [-]
emL                     0.3;           // Liquid emissivity [-]
TRef                    300;           // Radiation reference temperature [K]
T_ambient               300;           // Ambient temperature [K]
h_convection            0;             // Convective heat transfer coefficient [W/m2/K]


// ------------------------------------------------------------------------- //
// Surface tension and Marangoni model
// surfaceTensionModel: constant | linear | FeS
//   constant - flat sigma, flat Marangoni slope (Marangoni_Constant)
//   linear   - sigma(T) linear-clamped between sigma and sigma_at_Tvap;
//              Marangoni slope stays Marangoni_Constant
//   FeS      - Sahoo/DebRoy/McNallan Fe-S proxy drives sigma(T) and
//              dSigma/dT together (coupled):
//                sigma(T,S) = 1.943 - 4.3e-4*(T - 1809)
//                           - R*T*1.3e-8*ln(1 + 0.00318*aS*exp(1.66e8/(R*T)))
//              sulfurActivity is wt% style input: 0.01 ~= 100 ppm S.
// ------------------------------------------------------------------------- //

sigma                   1.87;          // Reference surface tension [N/m]
Marangoni_Constant      -4.9e-4;       // Fallback constant dSigma/dT [N/m/K]
surfaceTensionModel     FeS;      // constant | linear | FeS
sulfurActivity          0.01;          // Approx. 100 ppm S; only used when FeS


// ------------------------------------------------------------------------- //
// Recoil pressure and evaporation
// ------------------------------------------------------------------------- //

p0                      101325.0;      // Atmospheric pressure reference [Pa]
p_amb                   101325.0;      // Ambient pressure [Pa]
recoil_coeff            0.54;          // Clausius-Clapeyron prefactor [-]
Tvap                    3122;          // Vaporization temperature at p_amb [K]
Tvap_atm                3122;          // Vaporization temperature at p0 [K]
recoilPressureModel     condensation;  // condensation or modifiedReducedPressure
recoilTransitionWidth   10;            // Smooth recoil activation width [K]
Mm                      0.056;         // Molar mass [kg/mol]
LatentHeatVap           6.336e6;       // Latent heat of vaporization [J/kg]
LeeCoeff                0;             // Lee volumetric evaporation coefficient [1/s]


// ------------------------------------------------------------------------- //
// Scan direction
// ------------------------------------------------------------------------- //

V_scan          1.2;            // Scan speed (1200 mm/s)
scanDirection           (0 0 1);       // Scanning along +Z


// ------------------------------------------------------------------------- //
// Vapor plume Beer-Lambert attenuation
// ------------------------------------------------------------------------- //

vaporPlumeAttenuation   true;
muAlphaMax              310;           // [1/m]
pVaporMax               1e-7;          // [Pa m3]
H_plume                 1e-3;          // [m]
uMax                    1.5;           // [m/s]

// ************************************************************************* //
