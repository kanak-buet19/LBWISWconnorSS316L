#!/bin/bash
#
# Local driver for the CW melt-pool calibration swarm.
#
# Like cw_scantrack's Allrun, this expects OpenFOAM to be sourced in your shell
# (native install, laserbeamFoam/blockMesh on PATH). Each sim is launched
# natively via template_case/Allrun_long -- no Apptainer locally.
#
# The orchestrator itself runs on the host Python (needs scipy + pyvista),
# which is also used for the in-run melt-pool analysis.
#
# Override sizing/paths via env, e.g.:
#   CALIB_TOTAL_CORES=16 CALIB_CORES_PER_SIM=4 ./Allrun
#
set -Eeo pipefail

caseDir="$(cd "$(dirname "$0")" && pwd)"
cd "$caseDir"

export PYTHON="${PYTHON:-/home/kanak/.venv/venv314/bin/python}"
export CALIB_TOTAL_CORES="${CALIB_TOTAL_CORES:-16}"
export CALIB_CORES_PER_SIM="${CALIB_CORES_PER_SIM:-4}"

export MPLCONFIGDIR="$caseDir/.mplconfig"
mkdir -p "$MPLCONFIGDIR"

echo "=== CW calibration (local, native OpenFOAM) ==="
echo "PYTHON              = $PYTHON"
echo "WM_PROJECT_DIR      = ${WM_PROJECT_DIR:-UNSET (source OpenFOAM first!)}"
echo "CALIB_TOTAL_CORES   = $CALIB_TOTAL_CORES"
echo "CALIB_CORES_PER_SIM = $CALIB_CORES_PER_SIM"
echo "==============================================="

exec "$PYTHON" scripts/run_calibration.py "$@"
