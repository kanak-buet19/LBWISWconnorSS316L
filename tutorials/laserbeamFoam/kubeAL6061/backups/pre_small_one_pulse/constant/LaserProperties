FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      PhaseFieldProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

timeVsLaserPosition
{
    file    "$FOAM_CASE/constant/timeVsLaserPosition";
    outOfBounds clamp;
}

timeVsLaserPower
{
    file    "$FOAM_CASE/constant/timeVsLaserPower";
    outOfBounds clamp;
}

// Connor/Riffel 316L pulsed LBW settings:
// 1050 W peak power, 7.1 ms pulse time, 10 Hz frequency.
// timeVsLaserPower is treated as the on-pulse power.
pulseLaser true;
pulseFrequency 10;       // Hz
pulseDuration 0.0071;    // s
pulseStart 0;            // s
pulseEnd 0.20625;        // s
pulseOffPower 0;         // W

V_incident	(0 1 0);//(0 1 0);//NORMALISED IN CODE

laserRadius 200e-6;

N_sub_divisions	1;

nRadial	35; //50

nAngular	240; //360

wavelength	1.070e-6;

e_num_density	4e29;
//elec_resistivity	1.0e-6;

Radius_Flavour	2.0;

PowderSim false;

useLocalSearch    true;//false;

//N_sub_divisions    6;
