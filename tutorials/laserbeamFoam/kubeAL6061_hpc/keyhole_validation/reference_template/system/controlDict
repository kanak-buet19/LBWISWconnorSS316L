FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     laserbeamFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         0.0013;

deltaT          1e-7;

writeControl    runTime;

writeInterval   2.5e-5;

purgeWrite      0;

writeFormat     ascii;

writePrecision  10;

writeCompression uncompressed;

timeFormat      general;

timePrecision   10;

runTimeModifiable no;

adjustTimeStep  yes;

maxCo           0.35;
maxAlphaCo      0.35;

maxDeltaT       5e-5;

debugNumerics              false;
debugNumericsInterval      25;
debugNumericsSmallDeltaT   5e-8;
debugNumericsSmallDeltaTInterval 5;
debugNumericsCoFraction    0.95;

functions
{
    interfaceTemperatureProbes
    {
        type            probes;
        libs            ("libsampling.so");

        writeControl    timeStep;
        writeInterval   1;

        fields
        (
            T
            alpha.metal
            pVap
            recoilPressure
            Deposition
        );

        probeLocations
        (
            (0.4e-3 0.20e-3 0.4e-3)  // initial interface
            (0.4e-3 0.21e-3 0.4e-3)  // 10 um into metal
            (0.4e-3 0.22e-3 0.4e-3)  // 20 um into metal
        );
    }
}

