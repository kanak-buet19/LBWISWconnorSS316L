FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1.0;

// Kube Al6061 baseline stationary laser domain:
//   x = width, y = depth/laser-entry direction, z = sample thickness direction.
//   The laser-facing interface is square: 800 um x 800 um in x-z.
//   Gas depth is 200 um and metal depth is 600 um along y.
//   Base mesh spacing is uniform: 20 um in x, y, and z.

vertices
(
    (0       0       0)
    (0.8e-3 0       0)
    (0.8e-3 0.8e-3 0)
    (0       0.8e-3 0)
    (0       0       0.8e-3)
    (0.8e-3 0       0.8e-3)
    (0.8e-3 0.8e-3 0.8e-3)
    (0       0.8e-3 0.8e-3)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (40 40 40) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    lowerWall
    {
        type wall;
        faces
        (
            (3 7 6 2)
        );
    }

    atmosphere
    {
        type patch;
        faces
        (
            (1 5 4 0)
        );
    }

    rightWall
    {
        type patch;
        faces
        (
            (1 2 6 5)
        );
    }

    leftWall
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }

    frontAndBack
    {
        type patch;
        faces
        (
            (0 3 2 1)
            (5 6 7 4)
        );
    }
);

mergePatchPairs
(
);

